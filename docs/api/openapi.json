{
  "openapi": "3.1.0",
  "info": {
    "title": "RAGAcademic",
    "description": "Multimodal RAG chatbot untuk materi kuliah",
    "version": "0.3.0"
  },
  "paths": {
    "/documents/upload": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Upload Document",
        "description": "Upload a document, save to storage/{content_id}/, and index.\n\nIf content_id given → saved under storage/{content_id}/{filename}.\nOtherwise → saved to data/uploads/ with UUID prefix.\n\ncourse_id / course_name / week are optional — they power the guided catalog\n(mata kuliah → minggu → materi). If omitted they are derived from content_id\n(e.g. \"sbd-minggu-2\" → course \"sbd\", week 2).",
        "operationId": "upload_document_documents_upload_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_document_documents_upload_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/documents/index-batch": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Index Batch",
        "description": "Index all indexable documents in storage/{content_id}/.\n\nNon-indexable files (video, audio, images) are silently skipped.",
        "operationId": "index_batch_documents_index_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchIndexRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchIndexSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
