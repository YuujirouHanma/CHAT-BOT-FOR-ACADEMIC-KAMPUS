APP_ENV=development
LOG_LEVEL=INFO

# --- MULTI-TENANT (wajib dibaca sebelum deploy) ---
#
# Rahasia sisi server untuk hash kunci API, MAC jejak audit, dan indeks buta PII.
# WAJIB diisi di produksi (server menolak start bila kosong).
# JANGAN DIUBAH setelah ada kunci yang terbit: menggantinya membatalkan seluruh
# kunci yang beredar dan memutus verifikasi rantai audit yang sudah tertulis.
#   Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"
TENANT_KEY_PEPPER=

# Cocokkan `tenant_id` di body dengan yang diturunkan dari kunci API.
# Nilai di body TIDAK PERNAH menentukan akses — hanya dicocokkan untuk menangkap
# kunci yang tertukar di sisi pemanggil.
ENFORCE_TENANT_BODY_MATCH=true

# Tenant yang dipakai saat pengembangan lokal tanpa kunci sama sekali
# (hanya berlaku bila belum ada satu pun tenant terdaftar; ditolak di produksi).
DEV_ANONYMOUS_TENANT=dev

# Kunci global WARISAN dari versi satu-pelanggan (header X-API-Key).
# Tidak membawa identitas tenant, sehingga isolasi tidak dapat ditegakkan untuk
# permintaan yang memakainya. Dipertahankan hanya agar integrasi lama tidak
# putus di hari peralihan — di produksi server MENOLAK START bila ini terisi.
# Ganti dengan kunci per tenant: python -m scripts.tenantctl issue-key <tenant>
RAGACADEMIC_API_KEY=
LEGACY_TENANT_ID=default

# --- Enkripsi data pribadi (student_id) ---
# Di produksi kunci induk (KEK) harus datang dari KMS/Vault, bukan dari sini.
ENCRYPT_PII=false
PII_KEK=

# --- Pembatasan laju ---
# CATATAN: hitungannya disimpan di memori PROSES. Dengan >1 worker/replika,
# batas efektif berlipat jumlah proses — produksi wajib pakai backend Redis.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_PER_MINUTE=120
# Nyalakan HANYA bila ada proxy tepercaya di depan yang menimpa X-Forwarded-For.
# Tanpa itu, header ini dikendalikan pemanggil dan batas per-IP bisa dilewati.
TRUST_PROXY_HEADERS=false

# --- Pengerasan HTTP ---
# Bintang hanya wajar saat pengembangan. Di produksi isi daftar asal sungguhan:
# '*' bersama kredensial membuat halaman mana pun dapat memanggil API ini.
CORS_ALLOW_ORIGINS=*
TRUSTED_HOSTS=*
MAX_REQUEST_BODY_MB=110
ENABLE_HSTS=true

OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
HF_API_KEY=hf_...
OPENROUTER_API_KEY=sk-or-v1-...
GEMINI_API_KEY=AIza...

# Model bisa diganti per-request dari UI (field `model` = key dari GET /models).
# Model yang muncul di /models hanya yang providernya punya API key di atas.

# --- Transkripsi video/audio (agar rekaman kuliah bisa ditanya) ---
# Butuh ffmpeg terpasang di sistem/image. "disabled" = media disimpan tapi tak diindex.
TRANSCRIPTION_PROVIDER=groq
TRANSCRIPTION_MODEL=whisper-large-v3
TRANSCRIPTION_LANGUAGE=id
TRANSCRIPTION_SEGMENT_SECONDS=600

GENERATION_PROVIDER=openrouter
GENERATION_MODEL=openai/gpt-4o-mini

# QDRANT_MODE: "local" = embedded on-disk (tanpa server, untuk dev/tes lokal).
#              "server" = konek ke Qdrant server (WAJIB untuk Docker/produksi —
#              lihat service `qdrant` di docker-compose.yml). Tim BE set "server".
QDRANT_MODE=local
QDRANT_PATH=./qdrant_storage
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=classroom_docs
